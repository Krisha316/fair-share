hProvider({ children }) {\n  const [user, setUser] = useState(null);\n  const [loading, setLoading] = useState(!!getUserId());\n\n  const applyUser = (u) => {\n    setCurrency(u?.currency);\n    setUser(u);\n  };\n\n  useEffect(() => {\n    if (!getUserId()) return;\n    api\n      .get(\"/auth/me\")\n      .then(applyUser)\n      .catch(clearUserId)\n      .finally(() => setLoading(false));\n  }, []);\n\n  const authenticate = async (path, body) => {\n    const data = await api.post(path, body);\n    setUserId(data.user.id);\n    applyUser(data.user);\n  };\n\n  const value = {\n    user,\n    loading,\n    login: (body) => authenticate(\"/auth/login\", body),\n    register: (body) => authenticate(\"/auth/register\", body),\n    updateUser: (u) =>\n      setUser((prev) => {\n        const next = { ...prev, ...u };\n        setCurrency(next.currency);\n        return next;\n      }),\n    logout: () => {\n      clearUserId();\n      applyUser(null);\n    },\n  };\n\n  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;\n}"],"mappings":"AAAA,OAASA,aAAa,CAAEC,UAAU,CAAEC,SAAS,CAAEC,QAAQ,KAAQ,OAAO,CACtE,OAASC,GAAG,CAAEC,SAAS,CAAEC,SAAS,CAAEC,WAAW,KAAQ,OAAO,CAC9D,OAASC,WAAW,KAAQ,SAAS,CAAC,OAAAC,GAAA,IAAAC,IAAA,yBAEtC,KAAM,CAAAC,WAAW,cAAGX,aAAa,CAAC,IAAI,CAAC,CACvC,MAAO,MAAM,CAAAY,OAAO,CAAGA,CAAA,GAAMX,UAAU,CAACU,WAAW,CAAC,CAEpD,MAAO,SAAS,CAAAE,YAAYA,CAAAC,IAAA,CAAe,IAAd,CAAEC,QAAS,CAAC,CAAAD,IAAA,CACvC,KAAM,CAACE,IAAI,CAAEC,OAAO,CAAC,CAAGd,QAAQ,CAAC,IAAI,CAAC,CACtC,KAAM,CAACe,OAAO,CAAEC,UAAU,CAAC,CAAGhB,QAAQ,CAAC,CAAC,CAACE,SAAS,CAAC,CAAC,CAAC,CAErD,KAAM,CAAAe,SAAS,CAAIC,CAAC,EAAK,CACvBb,WAAW,CAACa,CAAC,SAADA,CAAC,iBAADA,CAAC,CAAEC,QAAQ,CAAC,CACxBL,OAAO,CAACI,CAAC,CAAC,CACZ,CAAC,CAEDnB,SAAS,CAAC,IAAM,CACd,GAAI,CAACG,SAAS,CAAC,CAAC,CAAE,OAClBD,GAAG,CACAmB,GAAG,CAAC,UAAU,CAAC,CACfC,IAAI,CAACJ,SAAS,CAAC,CACfK,KAAK,CAAClB,WAAW,CAAC,CAClBmB,OAAO,CAAC,IAAMP,UAAU,CAAC,KAAK,CAAC,CAAC,CACrC,CAAC,CAAE,EAAE,CAAC,CAEN,KAAM,CAAAQ,YAAY,CAAG,KAAAA,CAAOC,IAAI,C